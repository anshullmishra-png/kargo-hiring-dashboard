# ── Supabase (Project Settings → API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only for `npm run db:setup` (Project Settings → Database → Connection string, URI). Not needed at runtime.
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ── AI (set ONE; Gemini is used first if both are set) ──────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides
# LLM_MODEL=gemini-3.5-flash

# ── Resend ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
RESEND_FROM=Arjun at Kargo <onboarding@resend.dev>
# Replies go here (optional)
FOUNDER_EMAIL=
FOUNDER_NAME=Arjun Mehta
# Safety net while testing: if set, EVERY email is sent to this address instead of the candidate.
TEST_RECIPIENT=

# ── Access ───────────────────────────────────────────────────────────
# Single shared password for the dashboard (required in production).
DASHBOARD_PASSWORD=
